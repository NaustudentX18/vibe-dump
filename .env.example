# Copy to .env on the device. Do not commit real secrets.
VIBEDUMP_DATABASE_PATH=data/vibedump.sqlite3

# Registry selector: "fake" (default, zero-config) or "real" (uses API keys below).
VIBEDUMP_REGISTRY=fake

# STT / LLM / TTS provider selection within the chosen registry.
VIBEDUMP_STT_PROVIDER=fake
VIBEDUMP_LLM_PROVIDER=fake
VIBEDUMP_TTS_PROVIDER=fake

# ALSA devices for Whisplay WM8960 (after PiSugar/Whisplay driver install).
# List cards: arecord -l / aplay -l
# VIBEDUMP_ALSA_CAPTURE_DEVICE=plughw:CARD=wm8960soundcard,DEV=0
# VIBEDUMP_ALSA_PLAYBACK_DEVICE=plughw:CARD=wm8960soundcard,DEV=0

# WebSocket streamed audio hard cap (~30s @ 16kHz mono 16-bit).
# VIBEDUMP_AUDIO_MAX_BYTES=1200000

# Local PC Ollama (LAN or Tailscale, no API key needed).
VIBEDUMP_PC_BASE_URL=http://desktop-ujsii52.local:11434
VIBEDUMP_PC_MODEL=qwen3-14b-agent

# Cloud LLM credentials. Any subset may be set; missing keys -> the provider
# stays unconfigured (the registry omits it, and its health entry reads
# ok=False with the missing-env reason).
#
# Format: set the variable in your private .env with the value from the
# provider. Examples (do not commit real values):
#   export OPENAI_API_KEY (e.g. sk-proj-AbCd...)
#   export GEMINI_API_KEY (e.g. AIzaSyD...)
#
# Do not paste real values into this committed example.

# Add provider credentials only in your private .env.
# Keep this committed example free of real credential variable assignments.
