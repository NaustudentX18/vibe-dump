[Unit]
Description=VibeDump Whisplay display refresh daemon
Documentation=https://github.com/hermes-pi/vibe-dump
ConditionPathExists=/dev/spidev0.0
After=vibedump.service
Wants=vibedump.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/vibe-dump
EnvironmentFile=-/home/pi/vibe-dump/.env
ExecStart=/home/pi/vibe-dump/.venv/bin/python -m vibedump.integrations.whisplay_daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
